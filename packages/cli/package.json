{
  "name": "@contractual/cli",
  "private": false,
  "version": "0.1.0-dev.8",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "contractual": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codotech/contractual.git",
    "directory": "packages/cli"
  },
  "homepage": "https://contractual.dev",
  "bugs": {
    "url": "https://github.com/codotech/contractual/issues"
  },
  "contributors": [
    {
      "name": "Omer Morad",
      "email": "omer.moradd@gmail.com"
    }
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/contractual-dev"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/contractual-dev"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "pnpm rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "tester": "jest --coverage --verbose",
    "lint": "eslint '{src,test}/**/*.ts'"
  },
  "files": [
    "bin",
    "dist",
    "src/config/schema.json",
    "README.md"
  ],
  "dependencies": {
    "@contractual/changesets": "workspace:*",
    "@contractual/governance": "workspace:*",
    "@contractual/types": "workspace:*",
    "@inquirer/prompts": "^8.5.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^6.0.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "ora": "^8.2.0",
    "yaml": "^2.8.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  }
}
