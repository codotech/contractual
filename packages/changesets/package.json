{
  "name": "@contractual/changesets",
  "private": false,
  "version": "0.1.0-dev.6",
  "description": "Changeset creation, parsing, and versioning utilities for Contractual",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./changesets": {
      "types": "./dist/changesets/index.d.ts",
      "import": "./dist/changesets/index.js"
    },
    "./versioning": {
      "types": "./dist/versioning/index.d.ts",
      "import": "./dist/versioning/index.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/codotech/contractual.git",
    "directory": "packages/changesets"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "pnpm rimraf dist",
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@contractual/types": "workspace:*",
    "semver": "^7.7.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/semver": "^7.5.8",
    "vitest": "^3.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
