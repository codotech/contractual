{
  "name": "contractual-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/codotech/contractual.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/codotech/contractual.git"
  },
  "homepage": "https://contractual.dev",
  "contributors": [
    {
      "name": "Omer Morad",
      "email": "omer.moradd@gmail.com"
    }
  ],
  "scripts": {
    "build": "pnpm lerna run build --stream",
    "build:watch": "pnpm -r run build:watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "lint": "pnpm lerna run lint --parallel",
    "prepare": "husky",
    "version:preview": "lerna changed --json | jq -r '.[] | \"\\(.name) → v\\(.version)\"'",
    "e2e:verdaccio:up": "docker compose -f local-e2e.docker-compose.yaml up -d",
    "e2e:verdaccio:down": "docker compose -f local-e2e.docker-compose.yaml down -v"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "lerna": "^8.2.3",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "@vitest/coverage-v8": "^3.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "json-schema-typed": "^8.0.2",
    "lint-staged": "^14.0.1",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "typescript": "~5.7.2",
    "vitest": "^3.0.3",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --ext .ts --fix"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
